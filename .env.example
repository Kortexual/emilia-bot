# Copy this file to .env and fill it in. Never commit .env (it is listed in .gitignore).

# Discord bot token: Developer Portal -> your application -> Bot -> Reset Token.
# Treat it like a password; if it ever leaks, reset it.
DISCORD_TOKEN=

# --- LM Studio ---------------------------------------------------------------------
# Base URL of LM Studio's local server (the address and port shown on its Developer tab).
LMSTUDIO_URL=http://127.0.0.1:1234/v1
# Exact model identifier (see the Developer tab, or run `lms ls`).
# Leave empty to use the first chat model LM Studio lists.
LMSTUDIO_MODEL=
# Only needed if you turned on authentication in LM Studio's server settings.
LMSTUDIO_API_KEY=

# --- Optional (remove the leading # to use) ------------------------------------------
# Left unset, LM Studio's own sampling settings apply.
# LMSTUDIO_TEMPERATURE=0.7
# LMSTUDIO_MAX_TOKENS=1024
# Seconds to wait for one LM Studio response. Big or reasoning models can be slow.
# LMSTUDIO_TIMEOUT=300
# How many generations to send to LM Studio at the same time.
# MAX_CONCURRENT_REQUESTS=1

# Also answer DMs without needing an @mention (default: only @mentions get answers).
# RESPOND_TO_DMS=false

# Let the model search the web when it is unsure of something.
# WEB_SEARCH=true
# SEARCH_RESULTS=4
# Add a small "Searched the web" line with links under answers that used a search.
# SHOW_SOURCES=true

# Let the model open and read a whole web page instead of only the search snippets. It can only open
# links from its search results or links people wrote in their message, and only public sites.
# The page is fetched directly from this computer, so the site sees your IP address. (default: true)
# FETCH_PAGES=true
# Characters of page text given to the model per page (about 4 characters per token). Raise it only
# if your model's context allows. (default: 6000, minimum 500)
# PAGE_MAX_CHARS=6000

# Give the model local file and terminal tools. This is off by default because any Discord user who
# can prompt the bot could otherwise ask it to operate files. Paths remain in COMPUTER_WORKSPACE.
# COMPUTER_TOOLS=false
# COMPUTER_WORKSPACE=
# COMMAND_TIMEOUT=30
# Advanced: allow absolute paths and paths outside COMPUTER_WORKSPACE, and run commands outside the
# workspace sandbox. This gives the model access equivalent to the OS account running the bot; only
# enable it for a bot you fully control. Default commands use bubblewrap (bwrap) to expose only the workspace.
# COMPUTER_ALLOW_HOST_ACCESS=false
# By default every write, edit, delete, and command needs confirm=true in its tool call.
# Set false to let the model run those operations immediately.
# COMPUTER_REQUIRE_CONFIRMATION=true
# Give the model a headless Chromium browser it can open pages in and click, type and choose things on,
# for sites that need JavaScript or interaction. Off by default. Needs Playwright:
#   pip install playwright && playwright install chromium
# It opens only links from search results or the sender's message, then clicks its way from there.
# All browser traffic goes through a filter that only reaches public internet addresses, and each
# channel gets its own browser (cookies and logins aren't shared). (default: false)
# BROWSER_TOOLS=false
# By default every click, typing and dropdown choice needs confirm=true in its tool call.
# Set false to let the model use pages freely.
# BROWSER_REQUIRE_CONFIRMATION=true

# `restart_bot` is included with COMPUTER_TOOLS. It starts a replacement and only closes the old
# bot once Discord reports the replacement ready.

# Let the model work over several turns: after a tool call it is prompted again (and again) and can
# keep working and posting messages until it calls stop_talking. Off: at most two rounds of tools, then
# it must answer. MAX_TOOL_TURNS caps the generations for one message (minimum 2).
# MULTI_TURN_TOOLS=false
# MAX_TOOL_TURNS=8

# Ping members by any word of their name (for example a last name), not just the start of it.
# Needs "Server Members Intent" switched on in the Developer Portal (Bot > Privileged Gateway Intents),
# otherwise the bot will not start. (default: false)
# MEMBERS_INTENT=false

# An obsessive, possessive, over-the-top "yandere" Emilia: pouty and jealous, but never threatening,
# pressuring or sexual, and she drops the act if someone seems upset. Edit YANDERE_PERSONA in prompts.py
# to change her. (default: false)
# YANDERE_MODE=false

# Conversation memory: exchanges remembered per channel, and the cap on how much of
# it is sent to the model with each message (lower this if your context window is small).
# MEMORY_DB=memory.db
# MEMORY_TURNS=10
# MEMORY_MAX_CHARS=6000

# Keep habits from sticking. An emoji (or a trailing "~") used in one of the last N replies is
# removed from the next one, so a flourish can appear but never in every message (0 = off).
# STYLE_COOLDOWN=4
# A message like "from now on end every message with..." (and the bot's promise to do so) is
# shown to the model for one more message, then left out of its prompt.
# FORGET_STANDING_INSTRUCTIONS=true

# Longest message the bot reads, in characters; the rest is cut off. Discord allows 2000 characters,
# or 4000 with Nitro, so use 4000 to read those in full. (default: 2048)
# MAX_INPUT_CHARS=2048

# How much the bot writes to the console: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# LOG_LEVEL=INFO
